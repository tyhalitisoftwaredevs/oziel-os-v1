#!/bin/sh
set -e
MVN_VERSION=3.9.9
MVN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MVN_VERSION}"
if [ ! -x "${MVN_HOME}/bin/mvn" ]; then
  mkdir -p "${MVN_HOME}"
  curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MVN_VERSION}/binaries/apache-maven-${MVN_VERSION}-bin.tar.gz" | tar -xz --strip-components=1 -C "${MVN_HOME}"
fi
exec "${MVN_HOME}/bin/mvn" "$@"
